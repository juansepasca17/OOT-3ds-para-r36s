+/// changes to the title's RomFS, from romfs.patch in the data directory, as
+/// mods replacing files need: the image's bytes with pieces written over
+/// them, past its end too, at offsets from the RomFS's level 3. the file is
+/// "PNRP", a u32 count, then each piece's u64 offset, u32 length and bytes;
+/// tools/romfs_patch.py makes it from the files to replace.
+pub struct RomFsPatch {
+    pieces: Vec<(u64, Vec<u8>)>,
+    /// where the last piece ends, the RomFS's size at least.
+    pub end: u64,
+}
+
+impl RomFsPatch {
+    fn parse(bytes: &[u8]) -> Option<RomFsPatch> {
+        let u32_at = |at: usize| Some(u32::from_le_bytes(bytes.get(at..at + 4)?.try_into().ok()?));
+        if bytes.get(..4)? != b"PNRP" {
+            return None;
+        }
+        let (mut pieces, mut at, mut end) = (Vec::new(), 8, 0);
+        for _ in 0..u32_at(4)? {
+            let offset = u64::from_le_bytes(bytes.get(at..at + 8)?.try_into().ok()?);
+            let length = u32_at(at + 8)? as usize;
+            let data = bytes.get(at + 12..at + 12 + length)?.to_vec();
+            end = end.max(offset + length as u64);
+            pieces.push((offset, data));
+            at += 12 + length;
+        }
+        Some(RomFsPatch { pieces, end })
+    }
+
+    /// count bytes at offset in the RomFS, start in the image.
+    fn read(&self, image: &[u8], start: usize, offset: u64, count: usize) -> Vec<u8> {
+        let mut data = vec![0u8; count];
+        let have = image.len().saturating_sub(start).min(count);
+        if have > 0 {
+            data[..have].copy_from_slice(&image[start..start + have]);
+        }
+        let end = offset + count as u64;
+        for (at, piece) in &self.pieces {
+            let piece_end = at + piece.len() as u64;
+            if *at < end && offset < piece_end {
+                let from = offset.max(*at);
+                let to = end.min(piece_end);
+                data[(from - offset) as usize..(to - offset) as usize].copy_from_slice(&piece[(from - at) as usize..(to - at) as usize]);
+            }
+        }
+        data
+    }
+}
+
+/// the RomFS patch in the data directory, read once.
+pub fn romfs_patch(data_dir: Option<&std::path::Path>) -> Option<&'static RomFsPatch> {
+    static PATCH: std::sync::OnceLock<Option<RomFsPatch>> = std::sync::OnceLock::new();
+    PATCH
+        .get_or_init(|| {
+            let path = data_dir?.join("romfs.patch");
+            let bytes = std::fs::read(&path).ok()?;
+            let patch = RomFsPatch::parse(&bytes);
+            match &patch {
+                Some(patch) => log::info!("fs: RomFS patched by {}, {} pieces, up to 0x{:X}", path.display(), patch.pieces.len(), patch.end),
+                None => log::warn!("fs: {} is not a RomFS patch", path.display()),
+            }
+            patch
+        })
+        .as_ref()
+}
