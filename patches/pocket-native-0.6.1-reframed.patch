+/// svcOpenProcess, r1 = process id. Only the game's own process exists here,
+/// which code mods such as Ocarina ReFramed open to change their own pages.
+fn open_process(system: &mut System) {
+    let process_id = system.cpu.regs[1];
+    if process_id != system.kernel.process_id {
+        log::warn!("svcOpenProcess for process {process_id}, only {} exists", system.kernel.process_id);
+        system.cpu.regs[0] = errors::UNIMPLEMENTED.0;
+        return;
+    }
+    let object = system.kernel.objects.insert(KObject::Process);
+    let handle = system
+        .kernel
+        .handles
+        .create(&mut system.kernel.objects, object, "Process");
+    system.cpu.regs[0] = 0;
+    system.cpu.regs[1] = handle;
+}
+
+/// svcControlProcessMemory, r0 = process, r1 = addr0, r2 = addr1, r3 = size,
+/// r4 = operation, r5 = permission. Code mods use it on their own process to
+/// make the code they loaded past .data executable. Pages here carry no
+/// execute permission, so protecting mapped memory has nothing to do.
+fn control_process_memory(system: &mut System) {
+    let [_process, addr0, _addr1, size, operation, permission] = [0, 1, 2, 3, 4, 5].map(|r| system.cpu.regs[r]);
+    if operation & MEMOP_OP_MASK == MEMOP_PROTECT {
+        log::info!("svcControlProcessMemory protects 0x{addr0:08X}, 0x{size:X} bytes, permission {permission}: nothing to do");
+        system.cpu.regs[0] = 0;
+        return;
+    }
+    log::warn!("svcControlProcessMemory operation {operation} at 0x{addr0:08X}, 0x{size:X} bytes, not implemented");
+    system.cpu.regs[0] = errors::UNIMPLEMENTED.0;
+}
+
 fn get_resource_limit(system: &mut System) {
     let _process = system.cpu.regs[1];
     let object = system.kernel.objects.insert(KObject::ResourceLimit);
