@@ -0,0 +1,90 @@
+#include "oot3d_r36s_performance.h"
+
+#include <nlohmann/json.hpp>
+
+#include <cstdlib>
+#include <fstream>
+
+namespace Oot3dNativeGame {
+namespace {
+
+constexpr const char* kKeys[] = {"HalfRateDraw", "SimpleAudio", "ParallelFrontend", "ReducedActors"};
+constexpr const char* kEnvironment[] = {"OOT3D_HALF_RATE_DRAW", "OOT3D_SIMPLE_AUDIO",
+                                        "OOT3D_PARALLEL_FRONTEND", "OOT3D_REDUCED_ACTORS"};
+
+bool* Field(R36sPerformanceSettings& settings, size_t index) noexcept {
+    switch (index) {
+    case 0: return &settings.HalfRateDraw;
+    case 1: return &settings.SimpleAudio;
+    case 2: return &settings.ParallelFrontend;
+    default: return &settings.ReducedActors;
+    }
+}
+
+} // namespace
+
+R36sPerformance& R36sPerformance::Instance() {
+    static R36sPerformance instance;
+    return instance;
+}
+
+R36sPerformance::R36sPerformance() {
+    const char* path = std::getenv("OOT3D_R36S_CONFIG");
+    mPath = path != nullptr ? path : "config/r36s_perf.json";
+    R36sPerformanceSettings settings;
+    if (std::ifstream input(mPath); input) {
+        const auto json = nlohmann::json::parse(input, nullptr, false);
+        for (size_t index = 0; index < std::size(kKeys); ++index) {
+            if (json.is_object() && json.contains(kKeys[index]) && json[kKeys[index]].is_boolean()) {
+                *Field(settings, index) = json[kKeys[index]].get<bool>();
+            }
+        }
+    }
+    for (size_t index = 0; index < std::size(kEnvironment); ++index) {
+        if (const char* value = std::getenv(kEnvironment[index])) {
+            *Field(settings, index) = value[0] == '1';
+        }
+    }
+    Publish(settings);
+}
+
+void R36sPerformance::Publish(const R36sPerformanceSettings& settings) noexcept {
+    mHalfRateDraw.store(settings.HalfRateDraw, std::memory_order_relaxed);
+    mSimpleAudio.store(settings.SimpleAudio, std::memory_order_relaxed);
+    mParallelFrontend.store(settings.ParallelFrontend, std::memory_order_relaxed);
+    mReducedActors.store(settings.ReducedActors, std::memory_order_relaxed);
+}
+
+R36sPerformanceSettings R36sPerformance::Get() const noexcept {
+    return {HalfRateDraw(), SimpleAudio(), ParallelFrontend(), ReducedActors()};
+}
+
+bool R36sPerformance::Set(const R36sPerformanceSettings& settings, std::string* error) {
+    Publish(settings);
+    nlohmann::json json = nlohmann::json::object();
+    auto copy = settings;
+    for (size_t index = 0; index < std::size(kKeys); ++index) json[kKeys[index]] = *Field(copy, index);
+    std::ofstream output(mPath, std::ios::trunc);
+    output << json.dump(2) << '\n';
+    if (!output) {
+        if (error != nullptr) *error = "Cannot save " + mPath.string();
+        return false;
+    }
+    return true;
+}
+
+namespace GeneratedWholeAot {
+
+// Gameplay_Draw gate (whole_aot_cpp.py GATED_FUNCTIONS): with half-rate
+// drawing on, every other call returns at once.
+bool Oot3dNativeSkipGameplayDraw() noexcept {
+    static unsigned calls = 0U;
+    auto& performance = R36sPerformance::Instance();
+    if (!performance.HalfRateDraw()) return false;
+    if ((calls++ & 1U) == 0U) return false;
+    performance.MarkDrawSkipped();
+    return true;
+}
+
+} // namespace GeneratedWholeAot
+} // namespace Oot3dNativeGame
