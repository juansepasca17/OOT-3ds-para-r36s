+    while (const dirent *entry = readdir(tasks)) {
+      const long tid = std::strtol(entry->d_name, nullptr, 10);
+      if (tid <= 0) continue;
+      // Name, scheduler state and kernel wait channel: a thread blocked in a
+      // driver (state D) cannot run the backtrace handler.
+      char path[96], name[64] = "?", wchan[96] = "?", state = '?';
+      snprintf(path, sizeof path, "/proc/self/task/%ld/comm", tid);
+      if (FILE *f = fopen(path, "r")) { if (fgets(name, sizeof name, f)) name[strcspn(name, "\n")] = 0; fclose(f); }
+      snprintf(path, sizeof path, "/proc/self/task/%ld/wchan", tid);
+      if (FILE *f = fopen(path, "r")) { if (!fgets(wchan, sizeof wchan, f)) wchan[0] = 0; fclose(f); }
+      snprintf(path, sizeof path, "/proc/self/task/%ld/stat", tid);
+      if (FILE *f = fopen(path, "r")) {
+        char line[512];
+        if (fgets(line, sizeof line, f)) { if (const char *close = strrchr(line, ')')) state = close[2]; }
+        fclose(f);
