+void StartProfileFlusher() {
+  signal(SIGTERM, [](int) {
+    __gcov_dump();
+    _exit(0);
+  });
+  std::thread([] {
+    for (;;) {
+      std::this_thread::sleep_for(std::chrono::seconds(20));
