+        const std::uint32_t integer = static_cast<std::uint32_t>(input);
+        return {integer,
+                static_cast<float>(integer) == input ? 0U : VfpFastDetail::kIxc};
+    }
+    return oot3d::recomp::a32::VfpBinary32ToUnsigned(value, fpscr);
