+// VDIV: a double-precision quotient of two binary32 values rounds correctly
+// to binary32 (53 >= 2*24+2), and the quotient is exact exactly when
+// quotient * divisor, exact in double, equals the dividend.
+inline oot3d::recomp::a32::VfpBinary32Result Oot3dVfpDivide(
+    std::uint32_t left, std::uint32_t right, std::uint32_t fpscr) noexcept {
+    if ((fpscr & VfpFastDetail::kRoundingModeMask) == 0U &&
+        VfpFastDetail::OperandEligible(left) &&
+        VfpFastDetail::OperandEligible(right) &&
+        (right & 0x7FFFFFFFU) != 0U) [[likely]] {
+        const double dividend = static_cast<double>(VfpFastDetail::AsFloat(left));
+        const double divisor = static_cast<double>(VfpFastDetail::AsFloat(right));
+        const float quotient = static_cast<float>(dividend / divisor);
+        const std::uint32_t bits = VfpFastDetail::AsBits(quotient);
+        if ((left & 0x7FFFFFFFU) == 0U) {
+            return {bits, 0U};
+        }
+        if (VfpFastDetail::NonzeroResultEligible(bits)) {
+            return {bits, static_cast<double>(quotient) * divisor == dividend
+                              ? 0U : VfpFastDetail::kIxc};
+        }
+    }
+    return oot3d::recomp::a32::VfpBinary32Divide(left, right, fpscr);
+}
+
+// VSQRT: same double-rounding argument; exact when root * root == value.
+inline oot3d::recomp::a32::VfpBinary32Result Oot3dVfpSquareRoot(
+    std::uint32_t value, std::uint32_t fpscr) noexcept {
+    if ((fpscr & VfpFastDetail::kRoundingModeMask) == 0U &&
+        VfpFastDetail::OperandEligible(value) &&
+        ((value & 0x80000000U) == 0U || (value & 0x7FFFFFFFU) == 0U)) [[likely]] {
+        if ((value & 0x7FFFFFFFU) == 0U) {
+            return {value, 0U};
+        }
+        const double radicand = static_cast<double>(VfpFastDetail::AsFloat(value));
+        const float root = static_cast<float>(std::sqrt(radicand));
+        const double wide = static_cast<double>(root);
+        return {VfpFastDetail::AsBits(root),
+                wide * wide == radicand ? 0U : VfpFastDetail::kIxc};
+    }
+    return oot3d::recomp::a32::VfpBinary32SquareRoot(value, fpscr);
+}
+
+// VCMP/VCMPE: NZCV in the high bits, IOC only for NaN operands (which take
+// the software path).
+inline oot3d::recomp::a32::VfpBinary32Result Oot3dVfpCompare(
+    std::uint32_t left, std::uint32_t right, bool signalAllNans) noexcept {
+    constexpr std::uint32_t kNan = 0x7F800000U;
+    if ((left & 0x7FFFFFFFU) > kNan || (right & 0x7FFFFFFFU) > kNan) {
+        return oot3d::recomp::a32::VfpBinary32Compare(left, right, signalAllNans);
+    }
+    constexpr std::uint32_t kEqual = 0x60000000U;
+    constexpr std::uint32_t kLess = 0x80000000U;
+    constexpr std::uint32_t kGreater = 0x20000000U;
+    if (((left | right) & 0x7FFFFFFFU) == 0U || left == right) {
+        return {kEqual, 0U};
+    }
+    const bool leftSign = (left & 0x80000000U) != 0U;
+    if (leftSign != ((right & 0x80000000U) != 0U)) {
+        return {leftSign ? kLess : kGreater, 0U};
+    }
+    const bool less = leftSign ? (left & 0x7FFFFFFFU) > (right & 0x7FFFFFFFU)
+                               : left < right;
+    return {less ? kLess : kGreater, 0U};
+}
