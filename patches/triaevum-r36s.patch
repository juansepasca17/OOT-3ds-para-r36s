+std::string PicaGlDiagnosticFragment(std::string_view source) {
+    static const bool flat = std::getenv("OOT3D_GL_FLAT_FRAGMENT") != nullptr;
+    static const bool noDepth = std::getenv("OOT3D_GL_NO_FRAGDEPTH") != nullptr;
+    std::string text(source);
+    if (text.find("PicaFragmentUniforms") == std::string::npos) return text;
+    if (noDepth) {
+        size_t at = 0;
+        while ((at = text.find("gl_FragDepth", at)) != std::string::npos) {
+            const size_t lineStart = text.rfind('\n', at) + 1;
+            const size_t lineEnd = text.find(';', at);
+            if (lineEnd == std::string::npos) break;
+            if (text.find('=', at) < lineEnd) {
+                text.replace(lineStart, lineEnd + 1 - lineStart, "/* frag depth write removed */");
+                at = lineStart;
+            } else {
+                at += 12;
+            }
+        }
+    }
+    if (flat) {
+        const size_t mainAt = text.find("void main()");
+        const size_t brace = mainAt == std::string::npos ? mainAt : text.find('{', mainAt);
+        if (brace != std::string::npos) {
+            text.insert(brace + 1, " pica_color = vec4(0.6, 0.6, 0.6, 1.0); return;");
+        }
+    }
