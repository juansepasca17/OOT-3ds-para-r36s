--- /dev/null
+++ b/tools/oot3d/native_game_runtime/oot3d_r36s_performance.h
@@ -0,0 +1,65 @@
+#pragma once
+
+// Performance options of the R36S (RK3326) port, shown in the in-game menu
+// (Game > R36S performance) and stored in config/r36s_perf.json.
+//
+// Environment overrides, for A/B measurements (1 on, 0 off):
+//   OOT3D_HALF_RATE_DRAW, OOT3D_SIMPLE_AUDIO, OOT3D_PARALLEL_FRONTEND,
+//   OOT3D_REDUCED_ACTORS; OOT3D_R36S_CONFIG overrides the file path.
+
+#include <atomic>
+#include <filesystem>
+#include <string>
+
+namespace Oot3dNativeGame {
+
+struct R36sPerformanceSettings {
+    // The game prepares the 3D scene every other frame; the other frames
+    // repeat the previous picture. Logic, input and audio keep full rate.
+    bool HalfRateDraw = true;
+    // Cheaper audio mixing (no sample interpolation).
+    bool SimpleAudio = true;
+    // PICA command processing on a worker core.
+    bool ParallelFrontend = true;
+    // Actors drawn and updated at a shorter distance.
+    bool ReducedActors = false;
+};
+
+class R36sPerformance {
+  public:
+    static R36sPerformance& Instance();
+
+    R36sPerformanceSettings Get() const noexcept;
+    // Applies at once and saves; false (with message) when saving failed.
+    bool Set(const R36sPerformanceSettings& settings, std::string* error);
+
+    bool HalfRateDraw() const noexcept { return mHalfRateDraw.load(std::memory_order_relaxed); }
+    bool SimpleAudio() const noexcept { return mSimpleAudio.load(std::memory_order_relaxed); }
+    bool ParallelFrontend() const noexcept { return mParallelFrontend.load(std::memory_order_relaxed); }
+    bool ReducedActors() const noexcept { return mReducedActors.load(std::memory_order_relaxed); }
+
+    // Half-rate drawing: Gameplay_Draw was skipped this frame (set by the
+    // gate). The CTR presents a scene one frame after drawing it, so the
+    // frame to hide is the next one: called once per presented frame (main
+    // thread), this answers whether the previous frame skipped its draw.
+    void MarkDrawSkipped() noexcept { mDrawSkipped.store(true, std::memory_order_relaxed); }
+    bool ConsumeDrawSkipped() noexcept {
+        const bool previous = mPreviousDrawSkipped;
+        mPreviousDrawSkipped = mDrawSkipped.exchange(false, std::memory_order_relaxed);
+        return previous;
+    }
+
+  private:
+    R36sPerformance();
+    void Publish(const R36sPerformanceSettings& settings) noexcept;
+
+    std::filesystem::path mPath;
+    std::atomic<bool> mHalfRateDraw{true};
+    std::atomic<bool> mSimpleAudio{true};
+    std::atomic<bool> mParallelFrontend{true};
+    std::atomic<bool> mReducedActors{false};
+    std::atomic<bool> mDrawSkipped{false};
+    bool mPreviousDrawSkipped = false;
+};
+
+} // namespace Oot3dNativeGame
