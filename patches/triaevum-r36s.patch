+// Box-filtered mip chain of an RGBA8 image, level 1 onwards. UI textures
+// (menu fonts, HUD icons) are drawn far smaller than their texels on small
+// screens such as the R36S's 640x480: without mips, linear sampling skips
+// most strokes and the text vanishes.
+std::vector<std::vector<std::uint8_t>> BuildUiMipChain(
+    std::span<const std::uint8_t> rgba8, std::uint32_t width, std::uint32_t height) {
+    std::vector<std::vector<std::uint8_t>> levels;
+    std::span<const std::uint8_t> source = rgba8;
+    while (width > 1U || height > 1U) {
+        const std::uint32_t nextWidth = std::max(1U, width / 2U);
+        const std::uint32_t nextHeight = std::max(1U, height / 2U);
+        std::vector<std::uint8_t> next(static_cast<std::size_t>(nextWidth) * nextHeight * 4U);
+        for (std::uint32_t y = 0; y < nextHeight; ++y) {
+            for (std::uint32_t x = 0; x < nextWidth; ++x) {
+                for (std::uint32_t channel = 0; channel < 4U; ++channel) {
+                    std::uint32_t sum = 0U;
+                    for (std::uint32_t dy = 0; dy < 2U; ++dy) {
+                        for (std::uint32_t dx = 0; dx < 2U; ++dx) {
+                            const std::uint32_t sx = std::min(width - 1U, x * 2U + dx);
+                            const std::uint32_t sy = std::min(height - 1U, y * 2U + dy);
+                            sum += source[(static_cast<std::size_t>(sy) * width + sx) * 4U + channel];
+                        }
+                    }
+                    next[(static_cast<std::size_t>(y) * nextWidth + x) * 4U + channel] =
+                        static_cast<std::uint8_t>((sum + 2U) / 4U);
+                }
+            }
+        }
+        levels.push_back(std::move(next));
+        source = levels.back();
+        width = nextWidth;
+        height = nextHeight;
+    }
+    return levels;
+}
