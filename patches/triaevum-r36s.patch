+      __gcov_reset();
+      fprintf(stderr, "[pgo] profile flushed\n");
+    }
+  }).detach();
+}
+#endif
+
+void StartRenderStreamWatchdog(const Oot3dNativeGame::NativeRenderCommandStream &stream) {
+  const char *value = std::getenv("OOT3D_HANG_DUMP_SECONDS");
+  const int seconds = value != nullptr ? std::atoi(value) : 0;
+  if (seconds <= 0) return;
+  std::thread([&stream, seconds] {
+    uint64_t last = stream.ExecutedCommands();
+    int stalled = 0;
+    int dumps = 0;
+    while (dumps < 2) {
+      std::this_thread::sleep_for(std::chrono::seconds(1));
+      const uint64_t now = stream.ExecutedCommands();
+      stalled = now == last ? stalled + 1 : 0;
+      last = now;
+      if (stalled >= seconds) {
+        fprintf(stderr, "[hang] render stream stalled %d s at %llu commands\n", stalled,
+                static_cast<unsigned long long>(now));
+        DumpAllThreadBacktraces();
+        stalled = 0;
+        ++dumps;
+      }
+    }
+  }).detach();
+}
