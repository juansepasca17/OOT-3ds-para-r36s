+// Writes both uniform blocks of one draw into the ring with a single
+// unsynchronized map and binds the two ranges. False: use the legacy path.
+bool UploadPicaGlUniformsToRing(GfxRenderingAPIOGL::NativePicaState& state,
+                                std::span<const uint8_t> vertex,
+                                std::span<const uint8_t> fragment) {
+    if (!state.UniformRingEnabled || state.UniformRing == 0U) return false;
+    const GLsizeiptr align = state.UniformRingAlignment;
+    const auto aligned = [align](GLsizeiptr value) {
+        return (value + align - 1) / align * align;
+    };
+    const GLsizeiptr fragmentOffset = aligned(static_cast<GLsizeiptr>(vertex.size()));
+    const GLsizeiptr total = aligned(fragmentOffset + static_cast<GLsizeiptr>(fragment.size()));
+    if (total > state.kUniformRingSegment || vertex.empty() || fragment.empty()) return false;
+    if (state.UniformRingOffset + total > state.kUniformRingSegment) {
+        // Close this segment and move to the next one once the GPU is done with it.
+        GLsync& closing = state.UniformRingFences[state.UniformRingSegment];
+        if (closing != nullptr) glDeleteSync(closing);
+        closing = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        state.UniformRingSegment = (state.UniformRingSegment + 1) % state.kUniformRingSegments;
+        GLsync& next = state.UniformRingFences[state.UniformRingSegment];
+        if (next != nullptr) {
+            glClientWaitSync(next, GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ULL);
+            glDeleteSync(next);
+            next = nullptr;
+        }
+        state.UniformRingOffset = 0;
+    }
+    const GLintptr base = state.UniformRingSegment * state.kUniformRingSegment + state.UniformRingOffset;
+    glBindBuffer(GL_UNIFORM_BUFFER, state.UniformRing);
+    void* mapped = glMapBufferRange(GL_UNIFORM_BUFFER, base, total,
+                                    GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT |
+                                        GL_MAP_INVALIDATE_RANGE_BIT);
+    if (mapped == nullptr) {
+        state.UniformRingEnabled = false;  // driver refused: stay on the legacy path
+        return false;
+    }
+    std::memcpy(mapped, vertex.data(), vertex.size());
+    std::memcpy(static_cast<uint8_t*>(mapped) + fragmentOffset, fragment.data(), fragment.size());
+    glUnmapBuffer(GL_UNIFORM_BUFFER);
+    glBindBufferRange(GL_UNIFORM_BUFFER, 0, state.UniformRing, base,
+                      static_cast<GLsizeiptr>(vertex.size()));
+    glBindBufferRange(GL_UNIFORM_BUFFER, 4, state.UniformRing, base + fragmentOffset,
+                      static_cast<GLsizeiptr>(fragment.size()));
+    state.UniformRingOffset += total;
+    return true;
+}
